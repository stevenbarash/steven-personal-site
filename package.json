{
  "name": "steven-personal-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run type-check && next build --webpack && node scripts/check-built-output.mjs",
    "start": "next start",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse-local.mjs",
    "lint": "eslint .",
    "type-check": "next typegen && node node_modules/@typescript/native/lib/tsc.js --noEmit",
    "type-check:watch": "next typegen && node node_modules/@typescript/native/lib/tsc.js --noEmit --watch",
    "import:instagram": "node scripts/import-instagram.mjs --username steven.photography --limit 36",
    "check:evidence-reachability": "node scripts/check-evidence-reachability.mjs"
  },
  "dependencies": {
    "@once-ui-system/core": "^2.8.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "13.6.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false
  }
}
