{
  "name": "steven-personal-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run type-check && next build --webpack",
    "start": "next start",
    "test": "playwright test",
    "lint": "eslint .",
    "type-check": "next typegen && node node_modules/@typescript/native/lib/tsc.js --noEmit",
    "type-check:watch": "next typegen && node node_modules/@typescript/native/lib/tsc.js --noEmit --watch",
    "import:instagram": "node scripts/import-instagram.mjs --username steven.photography --limit 36"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
